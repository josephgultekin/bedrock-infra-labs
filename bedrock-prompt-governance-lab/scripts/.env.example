AWS_PROFILE=dops
# Set this explicitly - the profile's own default region may not match the
# region this lab was deployed to (check `tofu -chdir=.. output -raw prompt_arn`).
# boto3's Session().region_name only honors AWS_DEFAULT_REGION, not
# AWS_REGION, for region resolution - set both to be safe.
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1

# Fill these in from tofu outputs (from the lab root):
#   tofu -chdir=.. output -raw prompt_arn
#   tofu -chdir=.. output -raw source_bucket
#   tofu -chdir=.. output -raw invocation_log_group
#   tofu -chdir=.. output -raw cloudtrail_name
#   tofu -chdir=.. output -raw initial_version_arn
PROMPT_ARN=
SOURCE_BUCKET=
INVOCATION_LOG_GROUP=
CLOUDTRAIL_NAME=
PROMPT_VERSION_ARN=
